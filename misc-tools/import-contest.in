#!/usr/bin/env python3

'''
import-contest -- Convenience script to import a contest (including metadata,
teams and problems) from the command line. Defaults to using the CLI interface;
Specify a DOMjudge API URL as to use that.

Reads credentials from ~/.netrc when using the API.

See also https://www.domjudge.org/docs/manual/main/import.html
(replace main with the DOMjudge major.minor version if you are running a
released version, i.e. use 8.1 for DOMjudge 8.1.x)

Part of the DOMjudge Programming Contest Jury System and licensed
under the GNU GPL. See README and COPYING for details.
'''

from datetime import datetime
from os import listdir
from typing import List, Optional, Sequence, Tuple
import json
import os.path
import re
import subprocess
import sys
import time
import yaml

sys.path.append('@domserver_libdir@')
import dj_utils

webappdir = '@domserver_webappdir@'

# Only images that are untagged or have this tag are imported. The API supports
# a single image per entity, so importing dark mode images later requires API
# changes as well.
WANTED_TAG = 'light'
IMAGE_EXTENSIONS = ('png', 'jpg', 'jpeg', 'svg')


def usage():
    print(f'Usage: {sys.argv[0]} [<domjudge-api-url>]')
    exit(1)


def import_file(entity: str, files: List[str]) -> bool:
    any_matched = False
    for file in files:
        if os.path.exists(file):
            if dj_utils.confirm(f'Import {entity} from {file}?', False):
                print(f'Importing {entity}.')
                type = file.split('.')[1]
                response = dj_utils.upload_file(f'users/{entity}', type, file)
                print(json.dumps(response, indent=4))
                # After the first successfully imported file, we should stop
                return True
            else:
                print(f'Skipping {entity} import.')
            any_matched = True
    if not any_matched:
        if len(files) == 1:
            print(f'\'{files[0]}\' not found, skipping {entity} import.')
        else:
            prefix = [f'\'{item}\'' for item in files[:-1]]
            prefix_joined = ', '.join(prefix)
            last = f'\'{files[-1]}\''
            print(
                f'Neither {prefix_joined} nor {last} found, skipping {entity} import.')
    return False


def image_tags_eligible(tags: List[str]) -> bool:
    # Untagged images are usable as default per the CCS spec.
    return not tags or WANTED_TAG in tags


def parse_image_filename(filename: str, property: str) -> Optional[Tuple[List[str], Optional[int]]]:
    """Parse the CCS default filename pattern '<property>(.<tag>)*.<extension>'.
    Returns (tags, width) or None if the filename doesn't match."""
    parts = filename.split('.')
    if len(parts) < 2 or parts[0] != property or parts[-1].lower() not in IMAGE_EXTENSIONS:
        return None
    tags = []
    width = None
    for part in parts[1:-1]:
        # A '<W>x<H>' part specifies dimensions; a bare width is accepted for
        # backwards compatibility, e.g. 'logo.64.png'.
        size_match = re.fullmatch(r'(\d+)(?:x\d+)?', part)
        if size_match:
            width = int(size_match.group(1))
        else:
            tags.append(part)
    return tags, width


def select_image(candidates: List[Tuple[str, Optional[int]]], prefer_width: Optional[int],
                 ext_order: Sequence[str]) -> str:
    def sort_key(candidate):
        filename, width = candidate
        ext = filename.rsplit('.', 1)[-1].lower()
        # SVGs scale, so they match any preferred width.
        return (0 if prefer_width and (width == prefer_width or ext == 'svg') else 1,
                ext_order.index(ext) if ext in ext_order else len(ext_order),
                filename)
    return min(candidates, key=sort_key)[0]


def find_image(image_dir: str, property: str, file_refs: Optional[List[dict]],
               prefer_width: Optional[int], ext_order: Sequence[str]) -> Optional[str]:
    """Pick the image to upload for one entity. As per the CCS spec, files in image_dir
    matching the default filename pattern are considered in addition to the file references,
    but for files that are referenced the reference metadata is authoritative.
    Returns a filename inside image_dir, or None."""
    candidates = []
    ref_filenames = set()
    if file_refs is not None and not isinstance(file_refs, list):
        print(f'Warning: {property} for {image_dir} is not a list of file references, ignoring it.')
        file_refs = None
    for ref in file_refs or []:
        if not isinstance(ref, dict) or not isinstance(ref.get('filename'), str):
            print(f'Warning: ignoring malformed {property} file reference {ref!r} for {image_dir}.')
            continue
        ref_filenames.add(ref['filename'])
        if not image_tags_eligible(ref.get('tags') or []):
            continue
        if os.path.isfile(os.path.join(image_dir, ref['filename'])):
            candidates.append((ref['filename'], ref.get('width')))
        else:
            print(f'Warning: {property} \'{ref["filename"]}\' is referenced but not found in {image_dir}.')
    if os.path.isdir(image_dir):
        for filename in sorted(listdir(image_dir)):
            if filename in ref_filenames:
                continue
            parsed = parse_image_filename(filename, property)
            if parsed and image_tags_eligible(parsed[0]):
                candidates.append((filename, parsed[1]))
    if not candidates:
        return None
    return select_image(candidates, prefer_width, ext_order)


def import_images(entity: str, property: str, prefer_width: Optional[int] = None,
                  ext_order: Sequence[str] = IMAGE_EXTENSIONS):
    """Import images for the given entity, using file references from <entity>.json and files
    following the CCS default filename pattern"""

    if not os.path.isdir(entity):
        return
    file_refs = {}
    if os.path.isfile(f'{entity}.json'):
        with open(f'{entity}.json') as entity_file:
            for object in json.load(entity_file):
                file_refs[str(object['id'])] = object.get(property) or []
        entity_ids = list(file_refs)
    else:
        # E.g. teams imported from teams2.tsv: derive the IDs from the directory names.
        entity_ids = sorted(listdir(entity))

    images_per_entity = {}
    for entity_id in entity_ids:
        image_file = find_image(f'{entity}/{entity_id}', property,
                                file_refs.get(entity_id), prefer_width, ext_order)
        if image_file:
            images_per_entity[entity_id] = image_file

    if images_per_entity:
        if dj_utils.confirm(f'Import {property}s for {entity}?', False):
            for entity_id in images_per_entity:
                image_file = f'{entity}/{entity_id}/{images_per_entity[entity_id]}'
                print(f'Importing file {image_file} as {property} for {entity} entity with ID {entity_id}...')
                dj_utils.upload_file(f'{entity}/{entity_id}/{property}', property, image_file)
            print(f'{len(images_per_entity)} {property}s imported.')
        else:
            print(f'Skipping {entity} {property} import.')


def import_contest_banner(cid: str):
    """Import the contest banner"""

    banner_refs = None
    for contest_file, load in (('contest.yaml', yaml.safe_load), ('contest.json', json.load)):
        if os.path.isfile(contest_file):
            with open(contest_file) as f:
                contest_data = load(f)
            if isinstance(contest_data, dict):
                banner_refs = contest_data.get('banner') or []
            break

    ext_order = ('svg', 'png', 'jpg', 'jpeg')
    banner_file = find_image('contest', 'banner', banner_refs, None, ext_order)
    if banner_file:
        banner_file = f'contest/{banner_file}'
    else:
        # Legacy fallback: banner in the package root.
        banner_file = find_image('.', 'banner', None, None, ext_order)

    if banner_file:
        if dj_utils.confirm(f'Import {banner_file} for contest?', True):
            dj_utils.upload_file(f'contests/{cid}/banner', 'banner', banner_file)
            print('Contest banner imported.')
        else:
            print('Skipping contest banner import.')


def import_contest_problemset_document(cid: str):
    """Import the contest problemset document"""

    files = ['problemset.pdf', 'contest.pdf', 'contest-web.pdf', 'contest.html', 'contest.txt']

    text_file = None
    for file in files:
        if os.path.isfile(file):
            text_file = file
            break

    if text_file:
        if dj_utils.confirm(f'Import {text_file} for contest?', True):
            dj_utils.upload_file(f'contests/{cid}/problemset', 'problemset', text_file)
            print('Contest problemset imported.')
        else:
            print('Skipping contest problemset import.')


_RELTIME_RE = re.compile(r'^([+-])?(\d+):(\d{2}):(\d{2})(?:\.(\d+))?$')


class _YamlLoader(yaml.SafeLoader):
    pass


# PyYAML parses unquoted H:MM:SS as YAML 1.1 sexagesimal numbers; keep them as strings like Symfony YAML.
_YamlLoader.yaml_implicit_resolvers = {
    k: [('tag:yaml.org,2002:str', _RELTIME_RE)] + list(v)
    for k, v in yaml.SafeLoader.yaml_implicit_resolvers.items()
}


def _load_data_file(path: str):
    with open(path) as f:
        return json.load(f) if path.endswith('.json') else yaml.load(f, Loader=_YamlLoader)


def _first_key(data: dict, *keys: str):
    return next((data[k] for k in keys if data.get(k) is not None), None)


def _parse_reltime(value) -> Optional[float]:
    if isinstance(value, (int, float)):
        return round(float(value), 3)
    if isinstance(value, str):
        m = _RELTIME_RE.match(value.strip())
        if m:
            sign = -1.0 if m.group(1) == '-' else 1.0
            frac = float('0.' + m.group(5)) if m.group(5) else 0.0
            return round(sign * (int(m.group(2)) * 3600 + int(m.group(3)) * 60 + int(m.group(4)) + frac), 3)
    return None


def _format_reltime(seconds: float) -> str:
    sign = '-' if seconds < 0 else ''
    total_ms = round(abs(seconds) * 1000)
    total_s, ms = divmod(total_ms, 1000)
    hours, rem = divmod(total_s, 3600)
    minutes, secs = divmod(rem, 60)
    base = f'{sign}{hours}:{minutes:02d}:{secs:02d}'
    return f'{base}.{ms:03d}' if ms else base


def _norm_timestamp(value):
    dt = None
    if isinstance(value, datetime):
        dt = value
    elif isinstance(value, str):
        s = value.strip()
        if s.endswith(('Z', 'z')):
            s = s[:-1] + '+00:00'
        s = re.sub(r'([+-]\d{2})(\d{2})$', r'\1:\2', s)
        try:
            dt = datetime.fromisoformat(s)
        except ValueError:
            return value
    if dt is not None:
        return round(dt.timestamp(), 3) if dt.tzinfo is not None else dt.isoformat()
    return value


def _norm_reltime(value):
    secs = _parse_reltime(value)
    return value if secs is None else secs


def _norm_penalty(value):
    if isinstance(value, (int, float)):
        return round(float(value), 3)
    if isinstance(value, str):
        try:
            return round(float(value.strip()), 3)
        except ValueError:
            secs = _parse_reltime(value)
            return round(secs / 60.0, 3) if secs is not None else value
    return value


def _expected_contest_shortname(contest_data: dict) -> Optional[str]:
    short_name = _first_key(contest_data, 'short_name', 'shortname', 'short-name', 'id')
    return re.sub(r'[^a-zA-Z0-9_.-]', '_', str(short_name)) if short_name is not None else None


def find_existing_contest(contest_data: dict, contests: Sequence[dict]) -> Optional[dict]:
    """Find the contest that importing contest_data would create, matching ImportExportService::importContestData."""
    cid = _expected_contest_shortname(contest_data)
    if cid is None:
        return None
    return next((c for c in contests if cid in (c['id'], c.get('shortname'))), None)


def compare_contest_metadata(local_data: dict, existing: dict) -> List[str]:
    """Compare local contest metadata against an existing contest from the API."""
    diffs = []

    def check(api_field: str, local_val, normalize, compare_when_actual_none: bool = False):
        actual_val = existing.get(api_field)
        if local_val is None or (actual_val is None and not compare_when_actual_none):
            return
        if normalize(local_val) != normalize(actual_val):
            diffs.append(f'    - {api_field}:\n       is: {actual_val}\n      new: {local_val}')

    check('name', _first_key(local_data, 'name', 'formal_name'), str)
    check('shortname', _expected_contest_shortname(local_data), str)
    check('start_time', _first_key(local_data, 'start_time', 'start-time'), _norm_timestamp, compare_when_actual_none=True)
    check('duration', local_data.get('duration'), _norm_reltime)

    local_freeze = _first_key(local_data, 'scoreboard_freeze_duration', 'scoreboard-freeze-duration', 'scoreboard-freeze-length')
    if local_freeze is None:
        duration_sec = _parse_reltime(local_data.get('duration'))
        freeze_start_sec = _parse_reltime(_first_key(local_data, 'scoreboard-freeze', 'freeze'))
        if duration_sec is not None and freeze_start_sec is not None:
            local_freeze = _format_reltime(duration_sec - freeze_start_sec)
    check('scoreboard_freeze_duration', local_freeze, _norm_reltime, compare_when_actual_none=True)

    local_scoreboard_type = _first_key(local_data, 'scoreboard_type', 'scoreboard-type')
    check('scoreboard_type', local_scoreboard_type, str)
    if (local_scoreboard_type or existing.get('scoreboard_type')) != 'score':
        check('penalty_time', _first_key(local_data, 'penalty_time', 'penalty-time', 'penalty'), _norm_penalty)

    return diffs


def import_contest_metadata() -> Optional[str]:
    """Import contest.yaml or contest.json, or reuse the contest it describes if the server already has it."""
    contest_file = next((f for f in ('contest.yaml', 'contest.json') if os.path.exists(f)), None)
    if contest_file is None:
        print('Neither \'contest.yaml\' nor \'contest.json\' found, skipping contest metadata import.')
        return None

    contest_data = _load_data_file(contest_file)
    if isinstance(contest_data, dict):
        # Note: the API still excludes disabled contests (enabled = 0).
        existing = find_existing_contest(contest_data, dj_utils.do_api_request('contests?onlyActive=false'))
        if existing is not None:
            print(f"Contest '{existing['name']}' (cid={existing['id']}) already exists on the server.")
            diffs = compare_contest_metadata(contest_data, existing)
            if diffs:
                print('  - Differences between server and local contest metadata:')
                for d in diffs:
                    print(d)
                print('  - Note: updating contest metadata via the API is not supported; '
                      'update these fields in the jury interface if needed.')
            else:
                print('  - Contest metadata is already up-to-date.')
            if dj_utils.confirm(f"Use existing contest '{existing['name']}' (cid={existing['id']})?", True):
                return existing['id']
            print('Skipping contest metadata import.')
            return None

    if dj_utils.confirm(f'Import contest metadata (from {contest_file})?', True):
        print('Importing contest.')
        return dj_utils.upload_file('contests', contest_file.rsplit('.', 1)[1], contest_file)
    return None


def main():
    cid = None

    if len(sys.argv) == 1:
        dj_utils.domjudge_webapp_folder_or_api_url = webappdir
    elif len(sys.argv) == 2:
        dj_utils.domjudge_webapp_folder_or_api_url = sys.argv[1]
    else:
        usage()

    user_data = dj_utils.do_api_request('user')
    if 'admin' not in user_data['roles']:
        print('Your user does not have the \'admin\' role, can not import.')
        exit(1)

    import_file('groups', ['groups.json', 'groups.tsv'])
    if import_file('organizations', ['organizations.json']):
        # Also import logos if we have any.
        # We prefer SVG, then the 64x64 logo, and PNG before JPG.
        import_images('organizations', 'logo', prefer_width=64, ext_order=('svg', 'png', 'jpg', 'jpeg'))
    if import_file('teams', ['teams.json', 'teams2.tsv']):
        # Also import photos if we have any, but prefer JPG over SVG and PNG
        import_images('teams', 'photo', ext_order=('jpg', 'jpeg', 'png', 'svg'))
    import_file('accounts', ['accounts.json', 'accounts.yaml', 'accounts.tsv'])

    # Contest import is a special case: we can also gather the contest ID.
    cid = import_contest_metadata()

    if cid is not None:
        print(f' -> cid={cid}')
        import_contest_banner(cid)
        import_contest_problemset_document(cid)

    # Problem import is also special: we need to upload each individual problem and detect what they are
    if os.path.exists('problems.yaml') or os.path.exists('problems.json') or os.path.exists('problemset.yaml'):
        if dj_utils.confirm('Import problems?', True):
            # Check if our user is linked to a team.
            user_data = dj_utils.do_api_request('user')
            username = user_data['username']
            has_team_linked = 'team' in user_data and user_data['team']
            has_teamrole_set = 'roles' in user_data and 'team' in user_data['roles']
            if not has_team_linked or not has_teamrole_set:
                message = f"Jury submissions won't be imported, as your account ('{username}') is not properly configured:"
                if not has_team_linked:
                    message += "\n  - No team associated with your account."
                if not has_teamrole_set:
                    message += "\n  - Team role is not configured for your account."
                message += "\nReally continue?"
                if not dj_utils.confirm(message, False):
                    exit(2)
            print('Importing problems.')

            if cid is None:
                existing_contests = dj_utils.do_api_request('contests?onlyActive=false')
                if existing_contests:
                    print("The DOMjudge server already has these contests:")
                    for c in existing_contests:
                        print(f"'{c['name']}' with cid: {c['id']}")
                else:
                    print("No known contests yet.")
                cid = answer = input('Please specify the contest id: ')

            if os.path.exists('problems.yaml'):
                problems_file = 'problems.yaml'
            elif os.path.exists('problems.json'):
                problems_file = 'problems.json'
            else:
                problems_file = 'problemset.yaml'
            dj_utils.upload_file(f'contests/{cid}/problems/add-data', 'data', problems_file)

            if os.path.exists('problems.yaml'):
                with open('problems.yaml') as problemFile:
                    problemData = yaml.safe_load(problemFile)
                    problems = [problem['id'] for problem in problemData]
            elif os.path.exists('problems.json'):
                with open('problems.json') as problemFile:
                    problemData = json.load(problemFile)
                    problems = [problem['id'] for problem in problemData]
            else:  # problemset.json
                with open('problemset.yaml') as problemFile:
                    problemData = yaml.safe_load(problemFile)
                    problems = [problem['short-name']
                                for problem in problemData['problems']]

            confirmIndividually = dj_utils.confirm("Confirm individually for every problem", False)
            for problem in problems:
                problem = str(problem)
                print(f'\nPreparing problem \'{problem}\'.')
                if not re.match(r'^[a-zA-Z0-9_.-]+$', problem) or problem in ('.', '..'):
                    print(f'Invalid problem identifier \'{problem}\'.')
                    exit(3)
                if not os.path.isdir(problem) or not os.path.isfile(f'{problem}/problem.yaml'):
                    print('Problem directory not found or doesn\'t contain a problem.yaml.')
                    exit(3)
                if os.path.exists(f'{problem}.zip'):
                    os.unlink(f'{problem}.zip')
                zip_command = f"zip -r '../{problem}' -- .timelimit *"
                process = subprocess.Popen(zip_command, cwd=problem, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, shell=True)

                lastLine = None
                for line in process.stdout:
                    if lastLine:
                        sys.stdout.write("\r" + " " * len(lastLine))
                    sys.stdout.write(f"\r{line.strip()}")
                    sys.stdout.flush()
                    lastLine = line

                exit_code = process.wait()
                if exit_code == 0:
                    if lastLine:
                        sys.stdout.write("\r" + " " * len(lastLine) + "\r")
                else:
                    print(f"\nZipping problem failed with exit code: {exit_code}")

                if ((not confirmIndividually) or dj_utils.confirm(f'Ready to import problem \'{problem}\' to problem={problem}. Continue?', True)):
                    print(f'Uploading problem \'{problem}\', please be patient, this may take a while.')
                    before = time.time()
                    response = dj_utils.upload_file(
                        f'contests/{cid}/problems', 'zip', f'{problem}.zip', {'problem': problem})
                    after = time.time()
                    if response and 'problem_id' in response:
                        upload_time = after - before
                        print(f'Problem imported with ID {response["problem_id"]} (took {upload_time:.2f}s):')
                        if 'messages' in response:
                            messages = response['messages']
                            types = {'info': '🛈 ', 'warning': '⚠️ ', 'danger': '🚨'}
                            for t, e in types.items():
                                if t in messages and messages[t]:
                                    print(f'  {e} {t.capitalize()}:')
                                    for message in messages[t]:
                                        print(f'    - {message}')
                    else:
                        print(json.dumps(response, indent=4))
        else:
            print('Skipping contest import.')
    else:
        print('Neither \'problems.yaml\', \'problems.json\' nor \'problemset.yaml\' found, skipping problems import.')


if __name__ == '__main__':
    main()
